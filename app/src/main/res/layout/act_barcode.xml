<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".BarcodeActivity">

    <!--#########################################################################################-->
    <!-- Status bar: scanner state plus Open/Close, one button per API. -->
    <!--#########################################################################################-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/statusDotView"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/barcode_status_dot" />

        <TextView
            android:id="@+id/statusTextView"
            style="@style/TextLabel"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/barcode_status_closed" />

        <Button
            android:id="@+id/openBtn"
            style="@style/PageButton"
            android:text="@string/open" />

        <Button
            android:id="@+id/closeBtn"
            style="@style/PageButton"
            android:layout_marginStart="8dp"
            android:text="@string/close" />

    </LinearLayout>

    <!--#########################################################################################-->
    <!-- Card showing decoded barcode results. -->
    <!--#########################################################################################-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="1"
        android:background="@drawable/barcode_result_card">

        <TextView
            android:id="@+id/resultTextView"
            style="@style/TextInfo"
            android:layout_width="match_parent"
            android:padding="16dp"
            android:text="@string/barcode_results_hint" />

    </ScrollView>

    <!--#########################################################################################-->
    <!-- Scan controls: Scan soft-triggers one decode session (same as a hardware button -->
    <!-- pull), Stop cancels it, Clear empties the result card. -->
    <!--#########################################################################################-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/clearBtn"
            style="@style/PageButton"
            android:enabled="false"
            android:text="@string/barcode_clear" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="180dp"
            android:layout_height="56dp"
            android:background="@drawable/barcode_scan_btn"
            android:enabled="false"
            android:letterSpacing="0.15"
            android:text="@string/barcode_scan"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/stopBtn"
            style="@style/PageButton"
            android:enabled="false"
            android:text="@string/barcode_stop" />

    </LinearLayout>

</LinearLayout>
