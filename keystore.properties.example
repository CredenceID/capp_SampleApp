# Optional developer-local signing for the sample app.
#
# Copy this file to keystore.properties (git-ignored) and fill in your values to
# sign builds with your own keystore instead of the default debug key.
# Credence ID engineers: point this at the platform keystore for your target
# device so `adb install -r` can update the preinstalled sample app.
#
# storeFile is resolved relative to the project root.
storeFile=../path/to/your.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
